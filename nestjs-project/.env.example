# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Host port published for the API. Default 3000. Set another value when 3000 is taken.
API_HOST_PORT=3000

# Host ports for Redis and MinIO. Defaults match the container ports.
REDIS_HOST_PORT=6379
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Object storage (MinIO in Compose, S3-compatible)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=streamtube
S3_ACCESS_KEY=streamtube
S3_SECRET_KEY=streamtube-secret

# Queue (Redis / BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# Video upload limits
VIDEO_MAX_BYTES=10737418240
VIDEO_PART_SIZE_BYTES=16777216
VIDEO_PRESIGN_EXPIRES_SECONDS=3600
